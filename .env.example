# Day 22 lab — env template. Copy to .env and fill in what you need.
# Every value is optional; defaults live in lab22/config.py.

# ───────────────────────────────────────────────────────────
# Compute tier — picks model, batch, data sizes
# ───────────────────────────────────────────────────────────
COMPUTE_TIER=T4                     # T4 | BIGGPU
# T4     → Qwen3-4B-Instruct-2507 (4-bit), 800 train / 100 held-out pairs, max_len 768
# BIGGPU → Qwen3-8B (4-bit, thinking off), 3500 / 200 pairs, max_len 1024

# ───────────────────────────────────────────────────────────
# Model + data overrides
# ───────────────────────────────────────────────────────────
# BASE_MODEL=unsloth/Qwen3-4B-Instruct-2507-unsloth-bnb-4bit
# BASE_MODEL=unsloth/gemma-4-E4B-it-unsloth-bnb-4bit   # alternative; check the exact id on the Hub first
# SFT_DATASET=saillab/alpaca-vietnamese-cleaned
# PREF_DATASET=sailor2/sea-ultrafeedback-onpolicy
# PREF_LANGUAGE=Vietnamese
# PREF_TRAIN=800
# PREF_EVAL=100

# ───────────────────────────────────────────────────────────
# DPO hyperparameters (LoRA DPO needs ~1e-6–1e-5; 5e-7 barely moves a LoRA)
# ───────────────────────────────────────────────────────────
DPO_BETA=0.1
DPO_LR=5e-6
DPO_EPOCHS=1
# DPO_LOSS=sigmoid                  # comma list, e.g. sigmoid,sft (= RPO)

# ───────────────────────────────────────────────────────────
# Judge for NB4. Default: a panel of two local reward models, no API key needed.
# An API judge (two A/B orders) is optional; no default model on purpose:
# model ids change, pick a current one.
# ───────────────────────────────────────────────────────────
# JUDGE_PROVIDER=rm                 # rm | openrouter | gemini | openai | anthropic
# JUDGE_RM_MODELS=Skywork/Skywork-Reward-V2-Qwen3-4B,Skywork/Skywork-Reward-V2-Llama-3.2-3B   # panel, comma-separated
# JUDGE_MODEL=google/gemini-2.5-flash  # API judges only (e.g. google/gemini-2.5-flash hoặc google/gemini-2.0-flash-001 trên OpenRouter)
# JUDGE_PROMPTS=50                  # held-out prompts judged (plus 8 fixed)
# OPENROUTER_API_KEY=               # key từ openrouter.ai
# GEMINI_API_KEY=                   # free tier at aistudio.google.com
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ───────────────────────────────────────────────────────────
# Optional: HuggingFace push / Weights & Biases
# ───────────────────────────────────────────────────────────
# HF_TOKEN=
# HF_REPO=<your-username>/lab22-dpo-vn
# WANDB_API_KEY=
# WANDB_PROJECT=lab22-dpo
